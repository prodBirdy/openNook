// Talks to Reminders for main.js: osascript -l JavaScript reminders.jxa <command> [args…]
//   lists                      every list with its open reminders, as JSON
//   complete <id> <true|false> marks a reminder done (or not)
//   add <listId> <title> [opts] adds a reminder to that list; opts is JSON:
//                              { due (ms), allDay, priority (0, 1 high, 5 medium, 9 low),
//                                flagged, alert (remind at the due time) }
function run(argv) {
  const R = Application("Reminders");
  const [cmd, a, b, c] = argv;
  if (cmd === "lists") {
    return JSON.stringify(R.lists().map((l) => {
      const rs = l.reminders.whose({ completed: false });
      const ids = rs.id(), names = rs.name(), due = rs.dueDate(), allDay = rs.alldayDueDate(),
        prio = rs.priority(), flagged = rs.flagged();
      return {
        id: l.id(), name: l.name(), color: l.color(),
        items: ids.map((id, i) => ({
          id, name: names[i], priority: prio[i], flagged: flagged[i],
          due: due[i] ? due[i].getTime() : allDay[i] ? allDay[i].getTime() : null,
          allDay: !due[i] && !!allDay[i],
        })),
      };
    }));
  }
  if (cmd === "complete") {
    R.reminders.byId(a).completed = b === "true";
    return "ok";
  }
  if (cmd === "add") {
    const title = (b ?? "").trim();
    if (!title) return "empty";
    const o = c ? JSON.parse(c) : {};
    const props = { name: title };
    if (o.priority) props.priority = o.priority;
    if (o.flagged) props.flagged = true;
    if (o.due != null) {
      const when = new Date(o.due);
      if (o.allDay) props.alldayDueDate = when;
      else {
        props.dueDate = when;
        if (o.alert) props.remindMeDate = when;
      }
    }
    R.lists.byId(a).reminders.push(R.Reminder(props));
    return "ok";
  }
  throw new Error(`unknown command ${cmd}`);
}
