const LAND_ROWS: u32 = 90u;
const LAND = array<u32, 507>(0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u, 2088960u, 1023u, 0u, 0u, 0u, 3892314112u, 4294966527u, 7u, 33554432u, 0u, 0u, 4043015680u, 1048575u, 496u, 245760u, 0u, 12582912u, 4294951908u, 67109375u, 0u, 96u, 0u, 1062322176u, 268434944u, 0u, 1073610764u, 112640u, 1879048192u, 3222138129u, 32767u, 3145728u, 58720252u, 2148532224u, 3287875585u, 4293919740u, 201326597u, 4294672896u, 335511551u, 3758030976u, 4055518847u, 2096896u, 1046528u, 4294967223u, 2143289343u, 4294967280u, 4164820991u, 3758096415u, 4227848191u, 4294967295u, 4287430655u, 3221225471u, 2151612920u, 3617521671u, 4294967295u, 4294967295u, 4294963215u, 738328575u, 480u, 4294966908u, 4294967295u, 2164260863u, 4294967231u, 469792775u, 3890216960u, 4294967295u, 4294967295u, 31457524u, 2155872254u, 39u, 4294737408u, 4294967295u, 4464639u, 4286580736u, 133177343u, 1098907648u, 4294967267u, 2147483647u, 268439296u, 4294959104u, 130975u, 4278459392u, 4294967295u, 1879310335u, 0u, 4194303998u, 1610612799u, 4294967283u, 4294967295u, 66559u, 4290772992u, 67108863u, 4289724416u, 4294967295u, 805306367u, 0u, 4294961152u, 25343u, 4294966784u, 4294967295u, 196607u, 0u, 1073741823u, 3758096392u, 4294967295u, 4294967295u, 39u, 4293918720u, 458751u, 4278059008u, 4294964201u, 4194303u, 0u, 4294967040u, 7u, 1007655166u, 4294967295u, 12799u, 4026531840u, 4194303u, 1136656384u, 4293394166u, 134217727u, 1u, 4294901760u, 255u, 4215291392u, 4294966911u, 1057279u, 0u, 268435424u, 2147483648u, 3892249313u, 2147483647u, 198u, 4227858432u, 65535u, 133693440u, 4294967108u, 254017535u, 0u, 4294934528u, 3u, 4026597312u, 4294967295u, 6207u, 0u, 2097136u, 4261412864u, 4294963071u, 134217727u, 0u, 4227858432u, 515u, 4294959104u, 4294966271u, 32767u, 0u, 538943488u, 2147483648u, 2139095039u, 4294967294u, 3u, 0u, 500u, 4294443008u, 4163889151u, 4194303u, 0u, 503316480u, 48u, 4294967232u, 4294840318u, 1279u, 0u, 140632064u, 4261412864u, 2145386495u, 16728032u, 0u, 0u, 262972u, 4294950