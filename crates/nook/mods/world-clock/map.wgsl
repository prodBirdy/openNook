// The world as dots on that grid, lit where the sun is up. P(0) is the sun's declination and
// P(1) the longitude under it, in degrees (main.js works them out from the clock); P(2) and
// P(3) are the latitudes at the top and bottom edges.

fn land(col: i32, row: i32) -> bool {
  if row < 0 || row >= i32(LAND_ROWS) { return false; }
  let c = u32((col % i32(LAND_COLS) + i32(LAND_COLS)) % i32(LAND_COLS));
  let i = u32(row) * LAND_COLS + c;
  return ((LAND[i / 32u] >> (i % 32u)) & 1u) == 1u;
}

fn hash(p: vec2f) -> f32 {
  return fract(sin(dot(p, vec2f(127.1, 311.7))) * 43758.5453);
}

fn scene(frag: vec2f, res: vec2f, t: f32) -> vec4f {
  let top = P(2);
  let bottom = P(3);
  let uv = frag / res;
  let lon = -180.0 + uv.x * 360.0;
  let lat = top - uv.y * (top - bottom);

  // Sunlight: the cosine of the sun's zenith angle here.
  let rad = 3.14159265 / 180.0;
  let dec = P(0) * rad;
  let cosz = sin(lat * rad) * sin(dec) + cos(lat * rad) * cos(dec) * cos((lon - P(1)) * rad);
  let day = smoothstep(-0.10, 0.06, cosz);

  // The dot of the cell this pixel is in.
  let cell = res.x / f32(LAND_COLS);
  let col = i32(floor((lon + 180.0) / 2.0));
  let row = i32(floor((90.0 - lat) / 2.0));
  let center = vec2f((f32(col) + 0.5) * 2.0 - 180.0, 90.0 - (f32(row) + 0.5) * 2.0);
  let cx = (center.x + 180.0) / 360.0 * res.x;
  let cy = (top - center.y) / (top - bottom) * res.y;
  let d = length(frag - vec2f(cx, cy));
  let dot = 1.0 - smoothstep(cell * 0.30, cell * 0.30 + 1.0, d);

  // Night is dim blue, day warm white; a few cities glow on the night side.
  let sea_day = vec3f(0.055, 0.075, 0.105);
  let sea_night = vec3f(0.015, 0.018, 0.028);
  var col3 = mix(sea_night, sea_day, day);
  if land(col, row) {
    let lit = vec3f(0.98, 0.90, 0.70);
    let dark = vec3f(0.17, 0.20, 0.27);
    var c = mix(dark, lit, day);
    let lights = step(0.86, hash(vec2f(f32(col), f32(row)))) * (1.0 - day);
    c = mix(c, vec3f(1.0, 0.78, 0.42), lights * 0.85);
    col3 = mix(col3, c, dot);
  }
  // A faint glow along the terminator.
  col3 += vec3f(0.30, 0.20, 0.10) * exp(-abs(cosz) * 26.0) * 0.18;
  return vec4f(col3, 1.0);
}
